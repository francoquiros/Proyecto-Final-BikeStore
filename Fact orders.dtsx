              refId="Package\Cargar Fact Orders\OLE DB Source"
              componentClassID="Microsoft.OLEDBSource"
              contactInfo="OLE DB Source;Microsoft Corporation; Microsoft SQL Server; (C) Microsoft Corporation; All Rights Reserved; http://www.microsoft.com/sql/support;7"
              description="OLE DB Source"
              name="OLE DB Source"
              usesDispositions="true"
              version="7">
              <properties>
                <property
                  dataType="System.Int32"
                  description="The number of seconds before a command times out.  A value of 0 indicates an infinite time-out."
                  name="CommandTimeout">0</property>
                <property
                  dataType="System.String"
                  description="Specifies the name of the database object used to open a rowset."
                  name="OpenRowset"></property>
                <property
                  dataType="System.String"
                  description="Specifies the variable that contains the name of the database object used to open a rowset."
                  name="OpenRowsetVariable"></property>
                <property
                  dataType="System.String"
                  description="The SQL command to be executed."
                  name="SqlCommand"
                  UITypeEditor="Microsoft.DataTransformationServices.Controls.ModalMultilineStringEditor">-- FACT_ORDERS: un pedido por fila. Calcula fechas, atraso y banderas.
SELECT
    order_id,
    customer_id,
    store_id,
    staff_id,
    order_status,

    -- date_key del pedido (order_date siempre existe)
    (YEAR(order_date) * 10000 + MONTH(order_date) * 100 + DAY(order_date)) AS order_date_key,

    -- date_key de la fecha requerida (siempre existe)
    (YEAR(required_date) * 10000 + MONTH(required_date) * 100 + DAY(required_date)) AS required_date_key,

    -- date_key de envio: si es NULL, apunta a la centinela (-1)
    CASE WHEN shipped_date IS NULL THEN -1
         ELSE (YEAR(shipped_date) * 10000 + MONTH(shipped_date) * 100 + DAY(shipped_date))
    END AS shipped_date_key,

    -- dias de atraso: solo si se envio; NULL si no
    CASE WHEN shipped_date IS NULL THEN NULL
         ELSE DATEDIFF(DAY, required_date, shipped_date)
    END AS days_late,

    -- bandera de tardio: 1 si se envio despues de lo requerido
    CASE WHEN shipped_date IS NOT NULL AND shipped_date &gt; required_date THEN 1
         WHEN shipped_date IS NOT NULL AND shipped_date &lt;= required_date THEN 0
         ELSE NULL
    END AS is_late,

    -- bandera de enviado: 1 si tiene fecha de envio
    CASE WHEN shipped_date IS NULL THEN 0 ELSE 1 END AS is_shipped
FROM sales.orders;</property>
